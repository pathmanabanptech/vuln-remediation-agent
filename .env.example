# Fine-grained PAT scoped to the single demo repository.
# Permissions: Contents (read/write), Pull requests (read/write). Nothing else.
GITHUB_TOKEN=your_fine_grained_pat_here

# Secret for calling the agent API (Authorization: Bearer <token>). At least 32 characters.
# Generate one with: openssl rand -hex 32
AGENT_API_TOKEN=

# Ollama model the agent uses (must support tool calling). Defaults to llama3.1.
# OLLAMA_MODEL=qwen2.5:7b-instruct

# Ollama server. Defaults to Ollama on the Docker host. To use a server in your private
# network (on-prem or a private cloud VPC), set its private address; never a public endpoint.
# OLLAMA_URL=http://ollama.internal:11434

# Headers sent on every Ollama request, for an Ollama behind an authenticating gateway.
# UPSTREAM_HEADERS={"Authorization": "Bearer your_gateway_token"}
